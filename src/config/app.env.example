PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# JWT secret (generate with: openssl rand -base64 48)
JWT_SECRET=change-me

# Session secret
SESSION_SECRET=change-me

# If using SSH to probe the same machine's system state
SYSTEM_USER=root
SYSTEM_HOST=127.0.0.1
SYSTEM_SSH_PORT=22
SYSTEM_SSH_KEY=/path/to/key
